initialpar {
	proton_frequency 100e6
}
spinsys {
    nuclei 17O
	channels
   quadrupole 1 2 1.5e6 0 0 0 0
}

par {
	method gcompute
     start_operator   Inx
    detect_operator  Inp
     crystal_file     zcw4180
#	spin_rate 12e3
     gamma_angles 64
     np   8192
#	    verbose
     sw 768e3
}

proc {
	zerofill 16384
    addlb 400 0.5
	save $(name)s_newfreq.fid
    ft
    save $(name)s_newfreq.spe
}
